# Must be 127.0.0.1, not localhost — frontend and backend need to be the same "site" for
# the session cookie (SameSite=Lax) to be sent on requests.
VITE_API_URL=http://127.0.0.1:3001

# iRacing OAuth ("single page app" client — PKCE, no client secret).
# client_id is not sensitive for a public/PKCE client, but keep the redirect_uri exact —
# it must match one registered with iRacing exactly, including 127.0.0.1 vs localhost.
VITE_IRACING_CLIENT_ID=wheel-2-wheel
VITE_IRACING_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/iracing

# Optional: base URL of the public marketing site (e.g. https://wheel2wheel.racing). Used for:
#  - the public shared-result page: website link in the header + "Get in touch" CTA linking to <url>/#join
#    (both hidden when unset)
#  - the hostname shown in the contact-inquiries subtitle (omitted when unset)
# VITE_PUBLIC_SITE_URL=https://wheel2wheel.racing
